# 배포 서버(/opt/seaturtle/.env)의 틀. 서버에서 cp .env.example .env 한 뒤 채운다.
# .env는 .gitignore에 있어 커밋되지 않는다. 비밀 값은 서버에서 만든다: openssl rand -hex 32

# 주소
SITE_DOMAIN=www.seaturtleoffice.site
APEX_DOMAIN=seaturtleoffice.site
STATS_DOMAIN=stats.seaturtleoffice.site

# DB 비밀번호(게임 DB, Umami DB)
POSTGRES_PASSWORD=
UMAMI_DB_PASSWORD=
# Umami 세션 서명용 비밀
UMAMI_APP_SECRET=

# 판정(OpenAI). 비우면 가짜 판정기로 돈다.
OPENAI_API_KEY=
# events.ip_hash에 섞는 비밀. 한 번 정하면 바꾸지 않는다(바꾸면 오늘 IP 한도가 새로 센다).
IP_HASH_SECRET=

# 방문 통계. Umami에 웹사이트를 등록한 뒤 ID를 넣고 deploy.sh를 다시 돌린다.
VITE_UMAMI_SRC=https://stats.seaturtleoffice.site/script.js
VITE_UMAMI_WEBSITE_ID=
