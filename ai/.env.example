# 이 파일을 복사해 .env로 만들고 값을 채운다: cp .env.example .env
# .env는 .gitignore에 들어 있어 커밋되지 않는다.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
# OPENAI_QUESTION_REASONING_EFFORT=minimal
# OPENAI_GUESS_REASONING_EFFORT=low
# LLM_PROVIDER=auto
# 처리 등급. 기본 priority(빠르지만 단가 1.8배). 비우면 표준 처리.
# OPENAI_SERVICE_TIER=priority
